<Project>
  <PropertyGroup>
    <DefaultTargetFramework>net10.0</DefaultTargetFramework>
    <DefaultClassLibTargetFrameworks>net8.0;net9.0;net10.0</DefaultClassLibTargetFrameworks>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPackable>false</IsPackable>
    <!-- Suppress missing XML documentation (1591)-->
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Version>1.0.0</Version>
    <PackageVersion>$(Version)</PackageVersion>
    <Authors>Zoltan Csizmadia</Authors>
  </PropertyGroup>

</Project>