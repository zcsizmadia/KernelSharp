<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(DefaultTargetFrameworks)</TargetFrameworks>
    <RootNamespace>KernelSharp.Build</RootNamespace>
    <AssemblyName>KernelSharp.Build</AssemblyName>
    <!-- Switches NvrtcApi.cs into its internal KernelSharp.Build variant -->
    <DefineConstants>$(DefineConstants);KERNELSHARP_BUILD_TASK</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>KernelSharp.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Shared NVRTC binding sources compiled into both this DLL and KernelSharp.dll -->
  <Import Project="..\KernelSharp.Nvrtc\KernelSharp.Nvrtc.projitems" Label="Shared" />

  <ItemGroup>
    <!-- MSBuild Task API — compile-time only; the build host provides these at runtime -->
    <PackageReference Include="Microsoft.Build.Framework"      PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" PrivateAssets="all" ExcludeAssets="runtime" />
    <!-- Roslyn syntactic parsing used by the task to discover [GpuKernel] methods -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp"  PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
