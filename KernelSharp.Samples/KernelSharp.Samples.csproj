<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(DefaultTargetFramework)</TargetFramework>
    <RootNamespace>KernelSharp.Samples</RootNamespace>
    <AssemblyName>KernelSharp.Samples</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!-- Import the KernelSharp MSBuild task for local project-reference builds.
       NuGet consumers get this auto-imported from the package's build/ folder. -->
  <Import Project="../KernelSharp/build/KernelSharp.targets" />

  <ItemGroup>
    <ProjectReference Include="..\KernelSharp\KernelSharp.csproj" />
  </ItemGroup>

</Project>
