<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>KernelSharp.SourceGenerator</RootNamespace>
    <AssemblyName>KernelSharp.SourceGenerator</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnforceExtendedAnalyzerRules>false</EnforceExtendedAnalyzerRules>
    <!-- Generators must not reference the package versions from the host app -->
    <IsRoslynComponent>true</IsRoslynComponent>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>

    <!-- Package metadata -->
    <PackageId>KernelSharp.SourceGenerator</PackageId>
    <Title>KernelSharp Source Generator — nvcc at build time</Title>
    <Description>
      Roslyn incremental source generator that compiles inline CUDA C/C++ kernels at build time.
      Annotate any partial method with [GpuKernel] (inline source or external .cu file), and the
      generator invokes nvcc in parallel, builds a multi-arch fatbinary for all target SM
      architectures, optionally gzip-compresses it, and embeds it as a base64 constant.  A fully
      type-safe launch wrapper using CudaBuffer&lt;T&gt; and the CUDA Driver API is emitted alongside.
      Auto-detects nvcc (CUDA_PATH, PATH, %ProgramFiles%\NVIDIA GPU Computing Toolkit) and
      MSVC cl.exe (VCToolsInstallDir, vswhere, directory scan) with zero user configuration.
    </Description>
    <PackageTags>cuda;gpu;kernels;nvcc;roslyn;sourcegenerator;hpc;ai;dotnet;csharp;analyzer</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/csizmadiatibor/KernelSharp</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <DevelopmentDependency>true</DevelopmentDependency>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <!-- Ship build/*.props so NuGet auto-imports it into every consuming project.
       This delivers CompilerVisibleProperty declarations + defaults without any
       manual setup required by the consumer.                                    -->
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="build\KernelSharp.SourceGenerator.props"
          Pack="true"
          PackagePath="build\KernelSharp.SourceGenerator.props" />
  </ItemGroup>

</Project>
