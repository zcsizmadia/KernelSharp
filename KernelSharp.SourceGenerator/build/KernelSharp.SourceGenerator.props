<Project>

  <!-- ── KernelSharp source-generator settings ────────────────────────────
       This file is auto-imported by NuGet into every project that references
       the KernelSharp.SourceGenerator package.  Override any property in
       your own .csproj or Directory.Build.props before this file is imported
       — the Condition="" guards ensure your values are never overwritten.   -->

  <PropertyGroup>
    <!-- Path to the CUDA include directory (contains cuda.h, cuda_runtime.h …).
         Required only if your kernels include CUDA or MatX headers directly.
         Example: <KernelSharpIncludePath>C:\cuda\include</KernelSharpIncludePath> -->
    <KernelSharpIncludePath Condition="'$(KernelSharpIncludePath)' == ''"></KernelSharpIncludePath>

    <!-- C++ standard passed to nvcc.  c++20 is the default and recommended.
         Override to c++17 only if your host toolchain doesn't support c++20.
         Example: <KernelSharpNvccStd>c++17</KernelSharpNvccStd> -->
    <KernelSharpNvccStd Condition="'$(KernelSharpNvccStd)' == ''">c++20</KernelSharpNvccStd>

    <!-- Explicit CCCL (Thrust / libcudacxx / CUB) root directory.
         Auto-detected from KernelSharpIncludePath/../build/_deps/cccl-src,
         then from CUDA_PATH/include/cccl (bundled since CUDA 12.4).
         Set only if your CCCL lives somewhere non-standard.
         Example: <KernelSharpCCCLPath>D:\libs\cccl</KernelSharpCCCLPath> -->
    <KernelSharpCCCLPath Condition="'$(KernelSharpCCCLPath)' == ''"></KernelSharpCCCLPath>

    <!-- Extra nvcc flags appended to every kernel compilation in this project.
         Per-kernel overrides go in [GpuKernel(ExtraFlags = "…")].
         Example: <KernelSharpNvccExtraFlags>-lineinfo</KernelSharpNvccExtraFlags> -->
    <KernelSharpNvccExtraFlags Condition="'$(KernelSharpNvccExtraFlags)' == ''"></KernelSharpNvccExtraFlags>

    <!-- Windows only: path to cl.exe used as nvcc host compiler.
         Auto-detected via vswhere, VCToolsInstallDir env var, or PATH.
         Set only if auto-detection picks the wrong VS installation.
         Example: <KernelSharpMsvcClPath>C:\VS\VC\Tools\MSVC\14.x\bin\HostX64\x64\cl.exe</KernelSharpMsvcClPath>
         Ignored on Linux (GCC is used automatically). -->
    <KernelSharpMsvcClPath Condition="'$(KernelSharpMsvcClPath)' == ''"></KernelSharpMsvcClPath>

    <!-- Comma-separated GPU architectures to embed SASS + PTX for.
         The CUDA driver picks the best match at runtime.
           compute_80 = Ampere  (A100 / RTX 30xx, 2020+)
           compute_89 = Ada     (RTX 40xx, 2022+)
           compute_90 = Hopper  (H100, 2022+)
         For faster debug builds, restrict to one arch:
           <KernelSharpTargetArchs>compute_89</KernelSharpTargetArchs>
         NOTE: commas only — semicolons are comment characters in the
         editorconfig format that CompilerVisibleProperty uses internally. -->
    <KernelSharpTargetArchs Condition="'$(KernelSharpTargetArchs)' == ''">compute_80,compute_89,compute_90</KernelSharpTargetArchs>

    <!-- Maximum parallel nvcc processes during build.
         Empty (default) = all available CPU cores.
         Set to 1 to serialise compilation when diagnosing nvcc errors.
         Example: <KernelSharpMaxParallelism>4</KernelSharpMaxParallelism> -->
    <KernelSharpMaxParallelism Condition="'$(KernelSharpMaxParallelism)' == ''"></KernelSharpMaxParallelism>

    <!-- Compression applied to the embedded fatbin byte array.
           none (default) = raw bytes embedded as base64.
           gzip           = compressed at build time, decompressed on first kernel call;
                            saves ~40–60 % in generated source size.
         Example: <KernelSharpFatbinCompression>gzip</KernelSharpFatbinCompression> -->
    <KernelSharpFatbinCompression Condition="'$(KernelSharpFatbinCompression)' == ''">none</KernelSharpFatbinCompression>
  </PropertyGroup>

  <!-- Forward every property to the Roslyn source generator via the
       CompilerVisibleProperty mechanism (reads through AnalyzerConfigOptions). -->
  <ItemGroup>
    <CompilerVisibleProperty Include="KernelSharpIncludePath" />
    <CompilerVisibleProperty Include="KernelSharpNvccStd" />
    <CompilerVisibleProperty Include="KernelSharpCCCLPath" />
    <CompilerVisibleProperty Include="KernelSharpNvccExtraFlags" />
    <CompilerVisibleProperty Include="KernelSharpMsvcClPath" />
    <CompilerVisibleProperty Include="KernelSharpTargetArchs" />
    <CompilerVisibleProperty Include="KernelSharpMaxParallelism" />
    <CompilerVisibleProperty Include="KernelSharpFatbinCompression" />
  </ItemGroup>

</Project>
