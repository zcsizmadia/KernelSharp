<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(DefaultTargetFramework)</TargetFramework>
    <RootNamespace>KernelSharp</RootNamespace>
    <AssemblyName>KernelSharp</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>

    <!-- Package metadata -->
    <PackageId>KernelSharp</PackageId>
    <Title>KernelSharp — Write CUDA Kernels in C#</Title>
    <Description>
      Write CUDA C/C++ kernels inline inside C# source files using raw string literals, annotate
      a partial method with [GpuKernel], and let the Roslyn source generator invoke nvcc at build
      time. The resulting multi-arch fatbinary is embedded directly in your assembly — no separate
      .ptx files, no CUDA Runtime API, no manual P/Invoke.  Supports strongly-typed CudaBuffer&lt;T&gt;
      device pointers, parallel multi-kernel compilation, gzip-compressed fatbin embedding, and
      zero-configuration GPU detection at runtime via the CUDA Driver API.
    </Description>
    <PackageTags>cuda;gpu;kernels;nvcc;roslyn;sourcegenerator;hpc;ai;llm;dotnet;csharp;device;parallel</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/csizmadiatibor/KernelSharp</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>KernelSharp.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- MSBuild Task API — compile-time only; the build host provides these at runtime -->
    <PackageReference Include="Microsoft.Build.Framework"      PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" PrivateAssets="all" ExcludeAssets="runtime" />
    <!-- Roslyn syntactic parsing used by the task to discover [GpuKernel] methods -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp"  PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- README ends up in the NuGet package root -->
    <None Include="..\README.md" Pack="true" PackagePath="\" />

    <!-- Pack the build/ props and targets so NuGet auto-imports them into consumers -->
    <None Include="build\KernelSharp.props"
          Pack="true" PackagePath="build\KernelSharp.props" />
    <None Include="build\KernelSharp.targets"
          Pack="true" PackagePath="build\KernelSharp.targets" />

    <!-- Pack KernelSharp.dll into build/ so the UsingTask AssemblyFile resolves in NuGet -->
    <None Include="$(OutputPath)$(AssemblyName).dll"
          Pack="true" PackagePath="build\$(AssemblyName).dll"
          Visible="false" />
  </ItemGroup>

</Project>
