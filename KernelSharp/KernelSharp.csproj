<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(DefaultTargetFrameworks)</TargetFrameworks>
    <RootNamespace>KernelSharp</RootNamespace>
    <AssemblyName>KernelSharp</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>

    <!-- Package metadata -->
    <PackageId>KernelSharp</PackageId>
    <Title>KernelSharp — Write CUDA Kernels in C#</Title>
    <Description>
      Write CUDA C/C++ kernels inline inside C# source files using raw string literals, annotate
      a partial method with [GpuKernel], and let the Roslyn source generator invoke nvcc at build
      time. The resulting multi-arch fatbinary is embedded directly in your assembly — no separate
      .ptx files, no CUDA Runtime API, no manual P/Invoke.  Supports strongly-typed CudaBuffer&lt;T&gt;
      device pointers, parallel multi-kernel compilation, gzip-compressed fatbin embedding, and
      zero-configuration GPU detection at runtime via the CUDA Driver API.
    </Description>
    <PackageTags>cuda;gpu;kernels;nvcc;roslyn;sourcegenerator;hpc;ai;llm;dotnet;csharp;device;parallel</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/zcsizmadia/KernelSharp</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <!-- KernelSharp.Build contains the MSBuild task; built before this project.
         ReferenceOutputAssembly=false keeps KernelSharp.dll free of a compile/runtime
         dependency on KernelSharp.Build.dll — only the NuGet build/ folder needs it. -->
    <ProjectReference Include="..\KernelSharp.Build\KernelSharp.Build.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- README ends up in the NuGet package root -->
    <None Include="..\README.md" Pack="true" PackagePath="\" />

    <!-- Pack the build/ props and targets so NuGet auto-imports them into consumers -->
    <None Include="build\KernelSharp.props"
          Pack="true" PackagePath="build\KernelSharp.props" />
    <None Include="build\KernelSharp.targets"
          Pack="true" PackagePath="build\KernelSharp.targets" />

    <!-- Pack KernelSharp.Build.dll into build/ so the UsingTask AssemblyFile resolves in NuGet.
         Use the lowest TFM (net8.0) — it loads on any .NET 8+ MSBuild host.
         $(TargetFramework) is empty during the outer multi-TFM pack pass, so it must be hardcoded. -->
    <None Include="..\KernelSharp.Build\bin\$(Configuration)\net8.0\KernelSharp.Build.dll"
          Pack="true" PackagePath="build\KernelSharp.Build.dll"
          Visible="false" />
  </ItemGroup>

</Project>
